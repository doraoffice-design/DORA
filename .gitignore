# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated by `next dev` on every run (Next's own agent-rules block).
# Root-anchored on purpose: a bare `CLAUDE.md` pattern would also ignore
# .claude/CLAUDE.md, which is the real project doc and is tracked.
/CLAUDE.md
/AGENTS.md

# per-machine hours-tracking hook state (raw session timestamps/commits,
# not the actual log — that's docs/hours-log/, which is tracked)
/.claude/hours/
