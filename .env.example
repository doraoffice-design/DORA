# Copy to .env and fill in. Never commit the real .env (Section 9.2).

# PostgreSQL — self-hosted, local dev database
DATABASE_URL=postgresql://drmp:drmp@localhost:5432/drmp_dev

# Session/JWT signing secret — long and random, different per environment
SESSION_SECRET=change-me-to-a-long-random-string

# Authorised DORA email account, for the outreach module (Section 2.4).
# Sending is gated on a recorded DEAN_APPROVER approval — these credentials
# do not, by themselves, authorise a send.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# No LLM/AI key here on purpose: no AI feature is in the Phase I scope, and
# adding one is a material change needing DORA's written approval first.
